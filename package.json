{
  "name": "qualitytest",
  "version": "0.1.0",
  "private": true,
  "description": "QUALITY TEST - plataforma corporativa de gestão de testes, registro de defeitos e acompanhamento de homologação",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace @qualitytest/shared && npm run prisma:generate --workspace @qualitytest/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace @qualitytest/shared && npm run build --workspace @qualitytest/api && npm run build --workspace @qualitytest/worker && npm run build --workspace @qualitytest/web",
    "dev:api": "npm run start:dev --workspace @qualitytest/api",
    "dev:web": "npm run dev --workspace @qualitytest/web",
    "dev:worker": "npm run dev --workspace @qualitytest/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:wait": "node scripts/wait-for-services.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "npm run seed --workspace @qualitytest/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
