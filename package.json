{
  "name": "qualitytest",
  "version": "0.1.0",
  "private": true,
  "description": "QUALITY TEST - plataforma corporativa de gestão de testes, registro de defeitos e acompanhamento de homologação",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace @qualitytest/shared",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run build --workspace @qualitytest/extension && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:report": "playwright show-report",
    "build": "npm run build --workspace @qualitytest/shared && npm run build --workspace @qualitytest/api && npm run build --workspace @qualitytest/worker && npm run build --workspace @qualitytest/web && npm run build --workspace @qualitytest/extension",
    "dev:api": "npm run start:dev --workspace @qualitytest/api",
    "dev:web": "npm run dev --workspace @qualitytest/web",
    "dev:worker": "npm run dev --workspace @qualitytest/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:up:minio": "docker compose -f docker/docker-compose.yml --profile minio up -d",
    "docker:up:s3mock": "docker compose -f docker/docker-compose.yml --profile s3mock up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml --profile minio --profile s3mock down",
    "docker:wait": "node scripts/wait-for-services.mjs",
    "docker:build:api": "docker build -f docker/api.Dockerfile -t qualitytest-api:latest .",
    "docker:build:worker": "docker build -f docker/worker.Dockerfile -t qualitytest-worker:latest .",
    "docker:build": "npm run docker:build:api && npm run docker:build:worker",
    "smoke:test": "node scripts/smoke-test.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "docs:openapi": "npm run docs:openapi --workspace @qualitytest/api",
    "db:seed": "npm run seed --workspace @qualitytest/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
