# =============================================================================
# QUALITY TEST - Variáveis de ambiente (exemplo)
# =============================================================================
# Copie este arquivo para `.env` na raiz do repositório e ajuste os valores.
#
# TODOS os valores abaixo são de DESENVOLVIMENTO LOCAL. Nenhuma credencial real
# de produção está (ou deve estar) versionada neste repositório.
# Nunca faça commit de um arquivo `.env` com segredos reais.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
NODE_ENV=development

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3333
# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# --- PostgreSQL --------------------------------------------------------------
# Valores alinhados com docker/docker-compose.yml (desenvolvimento).
POSTGRES_USER=qualitytest
POSTGRES_PASSWORD=qualitytest
POSTGRES_DB=qualitytest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qualitytest:qualitytest@localhost:5432/qualitytest?schema=public

# --- Redis (BullMQ) ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Deixe vazio em desenvolvimento (Redis local sem autenticação).
REDIS_PASSWORD=

# --- MinIO (S3 compatível, desenvolvimento) ----------------------------------
MINIO_ROOT_USER=qualitytest
MINIO_ROOT_PASSWORD=qualitytest123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qualitytest-dev
S3_ACCESS_KEY=qualitytest
S3_SECRET_KEY=qualitytest123

# --- Seed de desenvolvimento -------------------------------------------------
# Senha do usuário administrador criado pelo seed (`npm run db:seed`).
# NUNCA versione um valor real aqui. O seed falha se esta variável estiver vazia.
SEED_ADMIN_PASSWORD=
# E-mail do administrador criado pelo seed (valor de desenvolvimento).
SEED_ADMIN_EMAIL=admin@qualitytest.local
