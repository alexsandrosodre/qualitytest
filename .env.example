# =============================================================================
# QUALITY TEST - Variáveis de ambiente (exemplo)
# =============================================================================
# Copie este arquivo para `.env` na raiz do repositório e ajuste os valores.
#
# TODOS os valores abaixo são de DESENVOLVIMENTO LOCAL. Nenhuma credencial real
# de produção está (ou deve estar) versionada neste repositório.
# Nunca faça commit de um arquivo `.env` com segredos reais.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
NODE_ENV=development

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3333
# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:3000

# --- Autenticação (JWT) ------------------------------------------------------
# ATENÇÃO: em produção use um segredo FORTE e único (32+ bytes aleatórios).
# Nunca versione um segredo real. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# O valor abaixo é apenas de desenvolvimento. A API exige >= 32 caracteres e,
# em NODE_ENV=production, recusa este valor de exemplo (ETAPA 10).
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
# Tempo de vida do access token (ex.: 15m, 30m, 1h).
JWT_ACCESS_TTL=15m
# Tempo de vida do refresh token (ex.: 7d, 30d).
JWT_REFRESH_TTL=7d

# --- Rate limiting (global) --------------------------------------------------
# Janela em segundos e número máximo de requisições por janela.
# Endpoints sensíveis (login/refresh/reset) usam limites mais restritos.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Frontend (Next.js) ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3333/api

# --- Extensão Chrome (build) -------------------------------------------------
# URL base da API usada pela extensão. Lida no BUILD (apps/extension/build.mjs):
# é injetada no bundle e a origem é adicionada ao host_permissions do manifest.
# O domínio oficial de produção segue PENDENTE DE DEFINIÇÃO.
QUALITYTEST_API_BASE_URL=http://localhost:3333/api

# --- PostgreSQL --------------------------------------------------------------
# Valores alinhados com docker/docker-compose.yml (desenvolvimento).
POSTGRES_USER=qualitytest
POSTGRES_PASSWORD=qualitytest
POSTGRES_DB=qualitytest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qualitytest:qualitytest@localhost:5432/qualitytest?schema=public

# --- Redis (BullMQ) ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Deixe vazio em desenvolvimento (Redis local sem autenticação).
REDIS_PASSWORD=

# --- Notificações (Etapa 8) --------------------------------------------------
# Habilita o enfileiramento/publicação de notificações. 'false', '0' ou 'off'
# desativam: a API passa a usar o publicador no-op (nenhum evento é enfileirado).
NOTIFICATIONS_ENABLED=true
# Nº de jobs processados em paralelo pelo worker.
NOTIFICATIONS_CONCURRENCY=5
# URL pública do frontend usada para montar o link autenticado nas mensagens.
WEB_BASE_URL=http://localhost:3000

# --- WhatsApp oficial (Cloud API da Meta) ------------------------------------
# Canal DESATIVADO por padrão: enquanto WHATSAPP_PHONE_NUMBER_ID e
# WHATSAPP_CLOUD_API_TOKEN estiverem vazios, o adaptador é inerte (nenhuma
# chamada de rede) e a entrega é registrada como DESCARTADO. Preencha apenas com
# credenciais OFICIAIS da WhatsApp Business Platform / Cloud API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_TOKEN=
# Versão da Graph API usada na chamada (padrão v21.0).
WHATSAPP_API_VERSION=v21.0
# Nome do template aprovado (opcional). Quando vazio, envia-se texto livre
# (válido na janela de atendimento de 24h).
WHATSAPP_TEMPLATE_NAME=
# Código de idioma do template (padrão pt_BR).
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# --- IA opcional (Etapa 9) ---------------------------------------------------
# Módulo OPCIONAL e DESATIVÁVEL. Quando desativado, nenhuma sugestão é gerada e
# os endpoints de IA respondem 503. A IA é sempre assistiva: nenhuma mudança é
# aplicada automaticamente — exige confirmação humana.
AI_ENABLED=false
# Provedor de IA: 'local' (padrão, determinístico, sem rede e sem credenciais)
# ou 'external' (adaptador compatível com a API OpenAI). Com 'external' são
# obrigatórias as variáveis AI_BASE_URL/AI_API_KEY/AI_MODEL; sem elas o módulo
# permanece desativado. Qualquer outro valor cai no provedor desativado.
AI_PROVIDER=local
# Provedor externo (usado apenas com AI_PROVIDER=external). NUNCA verseione
# uma chave real. AI_BASE_URL deve incluir o prefixo de versão.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Tempo-limite da chamada HTTP ao provedor externo, em ms (padrão 20000).
AI_TIMEOUT_MS=20000

# --- MinIO (S3 compatível, desenvolvimento) ----------------------------------
MINIO_ROOT_USER=qualitytest
MINIO_ROOT_PASSWORD=qualitytest123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=qualitytest-dev
S3_ACCESS_KEY=qualitytest
S3_SECRET_KEY=qualitytest123

# --- Seed de desenvolvimento -------------------------------------------------
# Senha do usuário administrador criado pelo seed (`npm run db:seed`).
# NUNCA versione um valor real aqui. O seed falha se esta variável estiver vazia.
SEED_ADMIN_PASSWORD=
# E-mail do administrador criado pelo seed (valor de desenvolvimento).
SEED_ADMIN_EMAIL=admin@qualitytest.local
