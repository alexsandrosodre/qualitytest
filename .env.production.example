# =============================================================================
# QUALITY TEST - Variáveis de ambiente de PRODUÇÃO (modelo)
# =============================================================================
# MODELO. Copie para o cofre de segredos da plataforma (Vercel / provider da API)
# e substitua TODOS os campos "<definir>". NUNCA faça commit de valores reais.
#
# Este arquivo não é usado pelo build das imagens (`.dockerignore` exclui
# `.env.*`); ele documenta o conjunto completo esperado em produção.
# Referência: docs/architecture/deploy-infraestrutura.md §7.1.
# =============================================================================

# --- Ambiente ----------------------------------------------------------------
NODE_ENV=production

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3333
# Whitelist de CORS (CSV). Nunca usar "*" em produção.
CORS_ORIGIN=https://<definir-dominio-do-frontend>

# --- Autenticação (JWT) ------------------------------------------------------
# >= 32 caracteres, exclusivo de produção. A API recusa o valor de exemplo do
# .env de desenvolvimento quando NODE_ENV=production (ETAPA 10).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<definir-segredo-forte-32+>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Rate limiting (global) --------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- PostgreSQL (serviço gerenciado) -----------------------------------------
# Ex.: postgresql://usuario:senha@host:5432/banco?schema=public&sslmode=require
DATABASE_URL=<definir>

# --- Redis (serviço gerenciado, fila BullMQ) ---------------------------------
REDIS_HOST=<definir>
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<definir>

# --- Notificações ------------------------------------------------------------
# 'false'/'0'/'off' desativam o enfileiramento (publicador no-op).
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_CONCURRENCY=5
# URL pública do frontend usada nos links das mensagens.
WEB_BASE_URL=https://<definir-dominio-do-frontend>

# --- IA opcional (assistiva e desativável) -----------------------------------
# Apenas 'local' está implementado (sem rede e sem credenciais). Mantenha
# AI_ENABLED=false enquanto não houver provedor e base legal definidos.
AI_ENABLED=false
AI_PROVIDER=local

# --- Storage de anexos (S3 compatível) ---------------------------------------
S3_ENDPOINT=<definir>
S3_REGION=<definir>
S3_BUCKET=<definir>
S3_ACCESS_KEY=<definir>
S3_SECRET_KEY=<definir>

# --- Frontend (Vercel) -------------------------------------------------------
# Embutida no build do Next.js: definir Preview e Production com valores distintos.
NEXT_PUBLIC_API_URL=https://<definir-host-da-api>/api

# --- Seed (NÃO usar em produção) ---------------------------------------------
# O seed é exclusivo de desenvolvimento. Não configurar estas variáveis em
# produção: elas existem apenas para o comando `npm run db:seed`.
# SEED_ADMIN_PASSWORD=<definir>
# SEED_ADMIN_EMAIL=<definir>
